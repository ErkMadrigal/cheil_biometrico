#--------------------------------------------------------------------
# Copia este archivo a ".env" y ajusta los valores.
# CodeIgniter 4 permite sobreescribir CUALQUIER propiedad de Config/*.php
# usando el prefijo correspondiente (app.*, database.*), sin tocar PHP.
#--------------------------------------------------------------------

CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.baseURL = 'http://localhost:8080/'
app.appTimezone = 'America/Mexico_City'

#--------------------------------------------------------------------
# BASE DE DATOS (MySQL / MariaDB)
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = biometrico
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

#--------------------------------------------------------------------
# JWT (login del web panel y de la app movil)
#--------------------------------------------------------------------
JWT_SECRET = 'cambia-esto-por-una-cadena-larga-y-aleatoria'
JWT_TTL_SECONDS = 43200

#--------------------------------------------------------------------
# Verificacion facial (checkin desde la app movil)
# Distancia euclidiana maxima entre el descriptor guardado y el capturado
# para considerar que es la misma persona. Mas bajo = mas estricto.
#--------------------------------------------------------------------
FACE_MATCH_THRESHOLD = 0.6

#--------------------------------------------------------------------
# CORS: dominios permitidos a consumir la API (separados por coma).
# En desarrollo puedes dejar "*". En produccion pon tu dominio real del panel.
#--------------------------------------------------------------------
CORS_ALLOWED_ORIGINS = *
